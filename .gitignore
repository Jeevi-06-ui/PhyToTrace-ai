# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & Virtual Environments
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL: Never commit to Git)
.env
.env.local
.env.production
.env.staging
.env.*.local
*.env

# Credentials & Private Keys
*firebase-service-account*.json
firebase-credentials.json
*.pem
*.key
*.p12
*.crt

# Local Databases (Keep offline databases local)
*.db
*.sqlite
*.sqlite3
data/phytotrace.db
data/*.db

# Sensitive Uploaded Images & Local Asset Storage
data/inspections/
data/storage/
data/yolo_segmentation/
*.zip
PhytoTrace_CVAT_Pilot.zip

# Project large raw data files & annotations (Keep raw data safe locally)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
data/samples/*
!data/samples/.gitkeep

# Models & Checkpoints
# Untracked intermediate experiments:
models/checkpoints/*
!models/checkpoints/.gitkeep
models/exports/*
!models/exports/.gitkeep
*.pt
*.pth
*.onnx

# Exclude training curves, logs, and artifacts:
models/checkpoints/**/*.png
models/checkpoints/**/*.jpg
models/checkpoints/**/*.csv
models/checkpoints/**/*.yaml
models/checkpoints/**/*.bak

# Allow directory traversal for checkpoints but only track production weights:
!models/checkpoints/*/
!models/checkpoints/*/*/
!models/checkpoints/leaf_segmenter/leaf_unet_best.pt
!models/checkpoints/mine_segmenter/best.pt
!models/checkpoints/baseline/baseline_mobilenetv3_best.pt
!models/checkpoints/astra_leaf_experiment/leaf_unet_best.pt
!models/checkpoints/astra_mine_experiment/weights/best.pt

