models/checkpoints/*
!models/checkpoints/.gitkeep
models/exports/*
!models/exports/.gitkeep
*.pt
*.pth
*.onnx

# Frontend Next.js & Node.js
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local
frontend/.env.production
frontend/.env.development
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Experiments, Runs & Logs
experiments/*
!experiments/.gitkeep
runs/
logs/
*.log

