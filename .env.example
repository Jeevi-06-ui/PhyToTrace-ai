# =============================================================================
# PhytoTrace AI — Master Environment Configuration Template
# =============================================================================
# Copy this file to '.env' in your local environment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# All cloud integrations are engineered with resilient local/offline fallbacks.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & PYTORCH RUNTIME
# -----------------------------------------------------------------------------
# Environment mode: development, staging, production
PHYTOTRACE_ENV=development

# PyTorch hardware acceleration device: auto, mps (Apple Silicon), cuda (Nvidia GPU), cpu
PHYTOTRACE_DEVICE=auto

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
PHYTOTRACE_LOG_LEVEL=INFO

# FastAPI backend host and port
PHYTOTRACE_API_HOST=0.0.0.0
PHYTOTRACE_API_PORT=8000

# Next.js frontend port (default: 3000)
PORT=3000

# Backend public base URL (used by Next.js rewrites and frontend API clients)
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Server-side Firebase Admin SDK Service Account JSON path.
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key.
# If Firebase is unconfigured, guest scanning remains available. Account endpoints require Firebase.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Client-side Firebase Configuration (populated in Next.js environment)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=phytotrace-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=phytotrace-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=phytotrace-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------------------
# 3. MONGODB ATLAS CLUSTER (DUAL DATABASE ADAPTER)
# -----------------------------------------------------------------------------
# MongoDB connection URI (Standard SRV format from MongoDB Atlas).
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# If omitted or unreachable, PhytoTrace automatically falls back to local SQLite at 'data/phytotrace.db'.
MONGODB_URI=mongodb+srv://phytotrace_admin:ReplaceWithYourPassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=phytotrace

# -----------------------------------------------------------------------------
# 4. CLOUDINARY ASSET STORAGE (PRIMARY IMAGE & OVERLAY STORAGE)
# -----------------------------------------------------------------------------
# Storage provider selection: cloudinary (recommended), r2, or local
STORAGE_PROVIDER=cloudinary

# Cloudinary credentials for original leaf images, segmentation overlays, and thumbnails
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=phytotrace

# -----------------------------------------------------------------------------
# 5. CLOUDFLARE R2 ASSET STORAGE (OPTIONAL S3-COMPATIBLE ADAPTER)
# -----------------------------------------------------------------------------
# Cloudflare R2 Credentials for storing original leaf photos, segmentations, and overlays.
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
# If omitted and Cloudinary is unconfigured, PhytoTrace falls back to local disk at 'data/storage/'.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=phytotrace-assets
R2_PUBLIC_DOMAIN=assets.phytotrace.ai

# -----------------------------------------------------------------------------
# 6. GOOGLE GEMINI API (PHYTOTRACE AGRI ASSISTANT)
# -----------------------------------------------------------------------------
# Google AI Studio API Key for grounded agronomic guidance.
# Obtain free from: https://aistudio.google.com/
# If omitted, PhytoTrace automatically falls back to deterministic ICAR-IIHR rule-based expert advice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 7. WEATHER INTELLIGENCE SERVICE
# -----------------------------------------------------------------------------
# Open-Meteo telemetry is free and requires no API key (active by default).
# Optional: Google Maps Platform Weather API key (if preferred for commercial deployment)
GOOGLE_MAPS_WEATHER_API_KEY=

# -----------------------------------------------------------------------------
# 8. SECURITY & CORS SETTINGS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://phytotrace.ai

# Set only after rotating both MongoDB Atlas and Cloudinary credentials.
PHYTOTRACE_ROTATED_CLOUD_CREDENTIALS=0
PHYTOTRACE_ALLOW_LOCAL_SQLITE=0
PHYTOTRACE_CORS_ORIGINS=http://localhost:3000
# Frontend server-only origin for the Cloud Run HTTPS endpoint.
PHYTOTRACE_API_ORIGIN=http://127.0.0.1:8000
# Optional local research overrides. Use the original checkpoints by default.
# PHYTOTRACE_LEAF_CHECKPOINT=models/checkpoints/astra_leaf_experiment/leaf_unet_best.pt
# PHYTOTRACE_MINE_CHECKPOINT=models/checkpoints/astra_mine_experiment/weights/last.pt

GEMINI_ASSISTANT_MODEL=gemini-3.1-flash-lite
